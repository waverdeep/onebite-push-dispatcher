# onebite-push-dispatcher — adaptive daily-reminder Web Push dispatcher (Cloud Run Job)
#
# The job talks to the database and sends Web Push (VAPID). Auth/email/JWT
# settings are unused here but kept so config.Settings loads without changes.
# In Cloud Run, set these via --set-env-vars / --set-secrets instead of an .env file.

# ---- environment ----
ENV=local
SERVICE_TZ=Asia/Seoul

# ---- database (Supabase) ----
# Port 6543 = PgBouncer transaction pooler.
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.jbkwndkxzancsixlovpy
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_SCHEMA=onebite

# ---- Web Push (VAPID) ----
# Same key pair as onebite-server (held in Secret Manager). The private key
# signs deliveries; rotating it invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:onebite@example.com

# ---- send slot override (optional, local testing) ----
# Leave unset to use the current KST hour. Set to force a specific slot.
# PUSH_HOUR=14
